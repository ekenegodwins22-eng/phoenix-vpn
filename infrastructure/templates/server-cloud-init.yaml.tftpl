#cloud-config
package_update: true
packages:
  - wireguard-tools
  - iptables
write_files:
  - path: /usr/local/sbin/phoenix-wireguard-init
    permissions: '0750'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      install -d -m 0700 /etc/wireguard
      if [ ! -s /etc/wireguard/server_private.key ]; then
        umask 077
        wg genkey | tee /etc/wireguard/server_private.key | wg pubkey > /etc/wireguard/server_public.key
      fi
      PRIVATE_KEY="$(cat /etc/wireguard/server_private.key)"
      cat > /etc/wireguard/wg0.conf <<EOF
      [Interface]
      Address = 10.13.13.1/24
      ListenPort = 51820
      PrivateKey = $${PRIVATE_KEY}
      PostUp = sysctl -w net.ipv4.ip_forward=1
      PostUp = iptables -t nat -A POSTROUTING -s 10.13.13.0/24 -o $(ip -o -4 route show to default | awk '{print $5; exit}') -j MASQUERADE
      PostDown = iptables -t nat -D POSTROUTING -s 10.13.13.0/24 -o $(ip -o -4 route show to default | awk '{print $5; exit}') -j MASQUERADE
      EOF
      chmod 600 /etc/wireguard/wg0.conf /etc/wireguard/server_private.key
      systemctl enable --now wg-quick@wg0
runcmd:
  - [ bash, -lc, "echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-phoenix-wireguard.conf && sysctl --system" ]
  - [ bash, /usr/local/sbin/phoenix-wireguard-init ]
